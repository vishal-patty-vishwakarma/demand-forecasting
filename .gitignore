# # Ignore trained model files
# outputs/models/*.pkl

# # Ignore Python cache folders
# __pycache__/

# # Ignore compiled Python files
# *.pyc

# # Ignore environment variables file (may contain secrets)
# .env

# # Ignore Jupyter notebook auto-save checkpoints
# .ipynb_checkpoints/

